# Testnet secret keys for the agent identity used by this demo.
# Generate your own with `stellar keys generate <alias> --network testnet --fund`
# (for AGENT_OPS_SECRET) and a raw ed25519 keypair (for AGENT_SIGNING_SECRET,
# registered as the Signer::External pubkey on the smart account).
# Never commit real values here — this file only holds placeholders.
AGENT_OPS_SECRET=
AGENT_SIGNING_SECRET=
